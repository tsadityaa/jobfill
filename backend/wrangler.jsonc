{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobfill-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_ANON_KEY",
      "OPENROUTER_API_KEY"
    ]
  }
}
